{
  "name": "kiseki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "今夜、自分の空に見える人工衛星を、方角と時刻と軌跡で出す",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch": "tsx tools/fetch.ts",
    "convert": "tsx tools/convert.ts",
    "stars": "tsx tools/stars.ts",
    "check": "npm run check:sgp4 && npm run check:sun && npm run check:stars && npm run check:jaxa",
    "check:sgp4": "tsx tools/check-sgp4.ts",
    "check:sun": "tsx tools/check-sun.ts",
    "check:stars": "tsx tools/check-stars.ts",
    "check:jaxa": "tsx tools/check-jaxa.ts",
    "e2e": "vite build --outDir dist-e2e --emptyOutDir && tsx tools/e2e.ts",
    "screenshots": "tsx tools/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
